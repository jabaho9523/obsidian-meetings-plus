{
	"name": "meetings-plus",
	"version": "0.5.8",
	"description": "Subscribe to calendars and create pre-filled meeting notes in one click. No drag-and-drop, no Outlook required. ICS-based, privacy-first.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"obsidian-md",
		"calendar",
		"meeting-notes",
		"ics",
		"outlook",
		"google-calendar",
		"productivity",
		"pkm",
		"knowledge-management",
		"note-taking"
	],
	"author": "Jacob Holm",
	"license": "0BSD",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "10.0.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.12.0",
		"jiti": "2.7.0",
		"obsidian": "^1.13.1",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.71.0"
	},
	"dependencies": {
		"ical.js": "^2.0.0"
	}
}
